    <!-- http://purl.org/dc/terms/isReferencedBy -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/isReferencedBy"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/hsto#hasDamage -->


    <owl:ObjectProperty rdf:about="https://w3id.org/hsto#hasDamage">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#StructuralPart"/>
        <rdfs:range rdf:resource="https://w3id.org/dot#Damage"/>
        <rdfs:comment xml:lang="en">Associates a structural part with one or more damage instances described using the Damage Typology Ontology (DOT).</rdfs:comment>
        <rdfs:label xml:lang="en">has damage</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hsto#hasHistoricOpening -->


    <owl:ObjectProperty rdf:about="https://w3id.org/hsto#hasHistoricOpening">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#Facade"/>
        <rdfs:range rdf:resource="https://w3id.org/hsto#HistoricOpening"/>
        <rdfs:comment xml:lang="en">Links a facade to one or more historic openings present on its surface.</rdfs:comment>
        <rdfs:label xml:lang="en">has historic opening</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hsto#hasJoist -->


    <owl:ObjectProperty rdf:about="https://w3id.org/hsto#hasJoist">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#TimberFloor"/>
        <rdfs:range rdf:resource="https://w3id.org/hsto#Joist"/>
        <rdfs:comment xml:lang="en">Links a timber floor to its joist elements.</rdfs:comment>
        <rdfs:label xml:lang="en">has joist</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hsto#hasMainBeam -->


    <owl:ObjectProperty rdf:about="https://w3id.org/hsto#hasMainBeam">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#TimberFloor"/>
        <rdfs:range rdf:resource="https://w3id.org/hsto#MainBeam"/>
        <rdfs:comment xml:lang="en">Links a timber floor to its primary beam elements.</rdfs:comment>
        <rdfs:label xml:lang="en">has main beam</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hsto#hasOpeningComponent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/hsto#hasOpeningComponent">
        <rdfs:domain rdf:resource="https://w3id.org/beo#BuildingElementPart"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/hsto#Arch"/>
                    <rdf:Description rdf:about="https://w3id.org/hsto#Header"/>
                    <rdf:Description rdf:about="https://w3id.org/hsto#Jamb"/>
                    <rdf:Description rdf:about="https://w3id.org/hsto#Lintel"/>
                    <rdf:Description rdf:about="https://w3id.org/hsto#Sill"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Links a BEO building element part to a heritage-specific opening component (sill, jamb, header, lintel, arch).</rdfs:comment>
        <rdfs:label xml:lang="en">has opening component</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hsto#hasPlank -->


    <owl:ObjectProperty rdf:about="https://w3id.org/hsto#hasPlank">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#TimberFloor"/>
        <rdfs:range rdf:resource="https://w3id.org/hsto#Plank"/>
        <rdfs:comment xml:lang="en">Links a timber floor to its plank elements forming the floor deck.</rdfs:comment>
        <rdfs:label xml:lang="en">has plank</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hsto#hasVaultPart -->


    <owl:ObjectProperty rdf:about="https://w3id.org/hsto#hasVaultPart">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#Vault"/>
        <rdfs:range rdf:resource="https://w3id.org/hsto#VaultPart"/>
        <rdfs:comment xml:lang="en">Links a vault to its constituent parts, articulated at ABox level to capture specific typologies and geometries.</rdfs:comment>
        <rdfs:label xml:lang="en">has vault part</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hsto#isBuiltWithTraditionalConstructionTechnique -->


    <owl:ObjectProperty rdf:about="https://w3id.org/hsto#isBuiltWithTraditionalConstructionTechnique">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#StructuralPart"/>
        <rdfs:range rdf:resource="https://w3id.org/hsv#TraditionalConstructionTechnique"/>
        <rdfs:comment xml:lang="en">Links a structural part to a traditional construction technique as documented in the HSV ontology.</rdfs:comment>
        <rdfs:label xml:lang="en">is built with traditional construction technique</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hsto#isConnectedTo -->


    <owl:ObjectProperty rdf:about="https://w3id.org/hsto#isConnectedTo">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#StructuralPart"/>
        <rdfs:range rdf:resource="https://w3id.org/hsto#Connection"/>
        <rdfs:comment xml:lang="en">Links a structural part to a connection instance representing the physical interface with another structural part.</rdfs:comment>
        <rdfs:label xml:lang="en">is connected to</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hsto#isCoveredBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/hsto#isCoveredBy">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#HorizontalStructure"/>
        <rdfs:range rdf:resource="https://w3id.org/beo#Covering"/>
        <rdfs:comment xml:lang="en">Links a horizontal structure to the BEO covering element (floor finish or roof covering) overlying it.</rdfs:comment>
        <rdfs:label xml:lang="en">is covered by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hsto#isHostedByDoor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/hsto#isHostedByDoor">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#HistoricOpening"/>
        <rdfs:range rdf:resource="https://w3id.org/beo#Door"/>
        <rdfs:comment xml:lang="en">Links a historic opening to the BEO door element that hosts it.</rdfs:comment>
        <rdfs:label xml:lang="en">is hosted by door</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hsto#isHostedByWindow -->


    <owl:ObjectProperty rdf:about="https://w3id.org/hsto#isHostedByWindow">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#HistoricOpening"/>
        <rdfs:range rdf:resource="https://w3id.org/beo#Window"/>
        <rdfs:comment xml:lang="en">Links a historic opening to the BEO window element that hosts it.</rdfs:comment>
        <rdfs:label xml:lang="en">is hosted by window</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/hsto#isMadeOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/hsto#isMadeOf">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#Facade"/>
        <rdfs:range rdf:resource="https://w3id.org/hmo#MasonryWall"/>
        <rdfs:comment xml:lang="en">Links a facade to the masonry wall instances that compose it, each corresponding to a portion with homogeneous geometric and constructional characteristics.</rdfs:comment>
        <rdfs:label xml:lang="en">is made of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/hsto#hasAbsoluteDatation -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/hsto#hasAbsoluteDatation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/hsto#HistoricOpening"/>
                    <rdf:Description rdf:about="https://w3id.org/hsto#StructuralPart"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Records the absolute construction date or date range of a structural part or historic opening.</rdfs:comment>
        <rdfs:label xml:lang="en">has absolute datation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hsto#hasAccessibility -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/hsto#hasAccessibility">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#StructuralPart"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="en">Indicates whether a structural part is accessible for detailed survey, helping quantify the level of structural knowledge available.</rdfs:comment>
        <rdfs:label xml:lang="en">has accessibility</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hsto#hasConnectionQuality -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/hsto#hasConnectionQuality">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#Connection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A qualitative assessment of connection effectiveness (e.g. good/poor) used to inform modelling strategies such as rigid vs. flexible connections in FEM analysis.</rdfs:comment>
        <rdfs:label xml:lang="en">has connection quality</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hsto#hasHeight -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/hsto#hasHeight">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#Facade"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The height of a facade, in metres.</rdfs:comment>
        <rdfs:label xml:lang="en">has height</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hsto#hasLength -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/hsto#hasLength">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#Facade"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The length of a facade, in metres.</rdfs:comment>
        <rdfs:label xml:lang="en">has length</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hsto#hasRelativeDatation -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/hsto#hasRelativeDatation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/hsto#HistoricOpening"/>
                    <rdf:Description rdf:about="https://w3id.org/hsto#StructuralPart"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Records the relative construction chronology of a structural part or historic opening with respect to adjacent elements.</rdfs:comment>
        <rdfs:label xml:lang="en">has relative datation</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/hsto#stiffness -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/hsto#stiffness">
        <rdfs:domain rdf:resource="https://w3id.org/hsto#HorizontalStructure"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A qualitative or quantitative measure of the in-plane stiffness of a horizontal structural element (e.g. rigid/flexible).</rdfs:comment>
        <rdfs:label xml:lang="en">stiffness</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/hmo#MasonryWall -->


    <owl:Class rdf:about="https://w3id.org/hmo#MasonryWall"/>
    


    <!-- https://w3id.org/hsto#Arch -->


    <owl:Class rdf:about="https://w3id.org/hsto#Arch">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hsto#Header"/>
        <rdfs:comment xml:lang="en">A curved spanning element closing the top of a historic opening, typically featuring a keystone.</rdfs:comment>
        <rdfs:label xml:lang="en">Arch</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#Connection -->


    <owl:Class rdf:about="https://w3id.org/hsto#Connection">
        <rdfs:comment xml:lang="en">An explicit first-class object representing the physical interface between exactly two structural parts, enabling qualitative assessment of connection effectiveness.</rdfs:comment>
        <rdfs:label xml:lang="en">Connection</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#Facade -->


    <owl:Class rdf:about="https://w3id.org/hsto#Facade">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hsto#StructuralPart"/>
        <rdfs:comment xml:lang="en">A distinct structural object representing the exterior wall surface of a structural unit, capturing opening layout regularity, masonry typology variations, and damage patterns.</rdfs:comment>
        <rdfs:label xml:lang="en">Facade</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#Header -->


    <owl:Class rdf:about="https://w3id.org/hsto#Header">
        <rdfs:subClassOf rdf:resource="https://w3id.org/beo#BuildingElementPart"/>
        <rdfs:comment xml:lang="en">The horizontal spanning element at the top of a historic opening; superclass of hsto:Lintel and hsto:Arch.</rdfs:comment>
        <rdfs:label xml:lang="en">Header</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#HistoricOpening -->


    <owl:Class rdf:about="https://w3id.org/hsto#HistoricOpening">
        <rdfs:comment xml:lang="en">A wall opening considered historic, associated with both relative and absolute dating, whose configuration is relevant for seismic assessment.</rdfs:comment>
        <rdfs:label xml:lang="en">Historic Opening</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#HorizontalStructure -->


    <owl:Class rdf:about="https://w3id.org/hsto#HorizontalStructure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hsto#StructuralPart"/>
        <rdfs:comment xml:lang="en">A horizontal structural element such as a floor or roof assembly, providing diaphragm rigidity to the masonry aggregate.</rdfs:comment>
        <rdfs:label xml:lang="en">Horizontal Structure</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#Jamb -->


    <owl:Class rdf:about="https://w3id.org/hsto#Jamb">
        <rdfs:subClassOf rdf:resource="https://w3id.org/beo#BuildingElementPart"/>
        <rdfs:comment xml:lang="en">The vertical side framing element of a historic opening.</rdfs:comment>
        <rdfs:label xml:lang="en">Jamb</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#Joist -->


    <owl:Class rdf:about="https://w3id.org/hsto#Joist">
        <rdfs:comment xml:lang="en">A secondary timber element spanning between main beams or walls, supporting the floor planking.</rdfs:comment>
        <rdfs:label xml:lang="en">Joist</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#Lintel -->


    <owl:Class rdf:about="https://w3id.org/hsto#Lintel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hsto#Header"/>
        <rdfs:comment xml:lang="en">A flat horizontal spanning element closing the top of a historic opening.</rdfs:comment>
        <rdfs:label xml:lang="en">Lintel</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#MainBeam -->


    <owl:Class rdf:about="https://w3id.org/hsto#MainBeam">
        <rdfs:comment xml:lang="en">A primary timber beam supporting smaller joists in a timber floor assembly.</rdfs:comment>
        <rdfs:label xml:lang="en">Main Beam</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#Plank -->


    <owl:Class rdf:about="https://w3id.org/hsto#Plank">
        <rdfs:comment xml:lang="en">A timber plank forming the floor deck, providing diaphragm rigidity when overlaid.</rdfs:comment>
        <rdfs:label xml:lang="en">Plank</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#Quoin -->


    <owl:Class rdf:about="https://w3id.org/hsto#Quoin">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hsto#Connection"/>
        <rdfs:comment xml:lang="en">A connection formed by regularly cut interlocking corner stones providing enhanced mechanical interlocking between orthogonal walls.</rdfs:comment>
        <rdfs:label xml:lang="en">Quoin</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#Sill -->


    <owl:Class rdf:about="https://w3id.org/hsto#Sill">
        <rdfs:subClassOf rdf:resource="https://w3id.org/beo#BuildingElementPart"/>
        <rdfs:comment xml:lang="en">The base threshold element of a historic opening.</rdfs:comment>
        <rdfs:label xml:lang="en">Sill</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#StructuralPart -->


    <owl:Class rdf:about="https://w3id.org/hsto#StructuralPart">
        <rdfs:comment xml:lang="en">The main category for modelling individual structural components of a historic masonry aggregate, exhibiting material and construction homogeneity.</rdfs:comment>
        <rdfs:label xml:lang="en">Structural Part</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#Tie -->


    <owl:Class rdf:about="https://w3id.org/hsto#Tie">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hsto#Connection"/>
        <rdfs:comment xml:lang="en">A connection formed by metallic or wooden anchors used to tie structural parts together in historic masonry construction.</rdfs:comment>
        <rdfs:label xml:lang="en">Tie</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#TimberFloor -->


    <owl:Class rdf:about="https://w3id.org/hsto#TimberFloor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hsto#HorizontalStructure"/>
        <rdfs:comment xml:lang="en">A horizontal structural assembly composed of timber elements such as beams, joists, and planks.</rdfs:comment>
        <rdfs:label xml:lang="en">Timber Floor</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#Vault -->


    <owl:Class rdf:about="https://w3id.org/hsto#Vault">
        <rdfs:subClassOf rdf:resource="https://w3id.org/hsto#HorizontalStructure"/>
        <rdfs:comment xml:lang="en">A masonry vault used as a horizontal structural element, typically in lower storeys. Kept generic at TBox level; specific vault typologies are articulated at ABox level through hsto:VaultPart instances.</rdfs:comment>
        <rdfs:label xml:lang="en">Vault</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsto#VaultPart -->


    <owl:Class rdf:about="https://w3id.org/hsto#VaultPart">
        <rdfs:comment xml:lang="en">A constituent part of a masonry vault, used at ABox level to articulate specific vault typologies and geometries.</rdfs:comment>
        <rdfs:label xml:lang="en">Vault Part</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/hsv#TraditionalConstructionTechnique -->


    <owl:Class rdf:about="https://w3id.org/hsv#TraditionalConstructionTechnique"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/hsto -->


    <owl:NamedIndividual rdf:about="https://w3id.org/hsto">
        <terms:description xml:lang="en">The Historic Structure Ontology (HSTO) provides a formal representation of the physical configuration of masonry aggregates by explicitly modelling the relationships among their structural components, including facades, horizontal structures, openings, and connections.</terms:description>
    </owl:NamedIndividual>
</rdf:RDF>



